# Copier ce fichier en .env.local et renseigner les valeurs.

# Base de données (Supabase → Connect → ORMs / Prisma)
# Pooler (port 6543) pour le runtime, connexion directe (5432) pour les migrations.
DATABASE_URL="postgresql://postgres.xxx:[PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxx:[PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# Supabase (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL="https://xxx.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Stripe, mode test (Developers → API keys / Webhooks)
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# En local : secret affiché par `stripe listen`. En prod : secret de la destination webhook.
STRIPE_WEBHOOK_SECRET="whsec_..."

# Resend
RESEND_API_KEY="re_..."
# Expéditeur sur un domaine vérifié dans Resend. Défaut : onboarding@resend.dev
RESEND_FROM_EMAIL="Boutique <noreply@votre-domaine.fr>"
# Optionnel : adresse de réponse (boîte réelle)
RESEND_REPLY_TO=""
# Optionnel, dev uniquement : redirige tous les e-mails de commande vers cette adresse
RESEND_DEV_FALLBACK_TO=""
